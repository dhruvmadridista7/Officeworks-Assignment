# Copy to .env and adjust. Never commit .env.
# `docker compose up` must work after: cp .env.example .env

# ---------- API ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Browser origin allowed by CORS (Vite dev server by default).
# In Docker the web app is served on :8080 and proxies /api, so CORS is not
# exercised, but keep this correct anyway.
WEB_ORIGIN=http://localhost:5173

# ---------- Product data source (Fake Store adapter) ----------
FAKESTORE_BASE_URL=https://fakestoreapi.com
UPSTREAM_TIMEOUT_MS=5000
UPSTREAM_RETRIES=2
CACHE_TTL_SECONDS=300

# ---------- Featured ("top rated") products ----------
# Exactly 5 unique product IDs chosen by the entrepreneur, comma separated.
# Illustrative defaults. If invalid, the API falls back to the 5 highest rated.
FEATURED_PRODUCT_IDS=1,2,3,4,5

# ---------- Enquiry email ----------
SALES_INBOX=sales@example.com
EMAIL_FROM=catalogue@example.com
# Leave SMTP_HOST empty to use the console email sender (logs the email only).
# Running API on your machine with Mailpit in Docker: change SMTP_HOST to localhost
# Running API inside docker compose:                  SMTP_HOST=mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------- Enquiry rate limit (POST /api/enquiries only) ----------
ENQUIRY_RATE_LIMIT_MAX=5
ENQUIRY_RATE_LIMIT_WINDOW_MS=60000

# ---------- Web (Vite) ----------
# Base URL of OUR API including /api. Docker build overrides this to /api.
VITE_API_URL=http://localhost:4000/api
